# LLM / Embedding 配置模板：复制为 .env 并填入真实值（.env 已被 .gitignore 忽略）
# provider 切换走环境变量（不在本文件设置，避免与生产入口 server.py 的默认值冲突）：
#   LLM_PROVIDER=ark | xf_spark   未设置时走 MockLLMClient
#   EMBED_PROVIDER=ark             未设置时走 MockEmbeddingClient

# ---- 火山方舟 DeepSeek ----
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
ARK_CHAT_MODEL=deepseek-v4.1-flash

# ---- 火山方舟 Embedding ----
ARK_EMBED_MODEL=doubao-embedding-vision

# ---- 讯飞星火 Spark ----
SPARK_API_KEY=
SPARK_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2/chat/completions
SPARK_MODEL=spark-x2.6
